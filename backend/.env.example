# ================= ATE 防呆测试管理系统 · 后端配置 =================
# 复制本文件为 backend/.env 后按实际环境修改
# .env 已被 .gitignore 忽略，不会提交

# ---- PostgreSQL ----
# 默认使用 pg8000 纯 Python 驱动（无编译依赖）
# 若安装 psycopg2-binary，可改为 postgresql://user:pass@host:5432/db
# 本地开发/单测可改用 SQLite：sqlite:///./data/dev.db
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/ate_manager

# ---- 应用 ----
APP_DEBUG=true
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- CORS（多个用英文逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 认证（通道二：Web 管理 JWT）----
# 生产环境务必修改 JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168
# 首次启动自动创建的管理员账号（仅当用户表为空时）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=系统管理员

# ---- 上位机 API（通道一：X-API-Key）----
# pytest 运行时通过请求头 X-API-Key 访问 /api/v1/*；留空则仅允许网页登录用户调试
# V1_API_KEY=change-me-to-a-random-token

# ---- 防呆规则 ----
# 连续失败 N 次 → 工程锁定 LOCKED（需维修处置解锁）
FAIL_LIMIT=3
# 固件基线校验：false 时仅记录不拦截（换线调试期可用）
ENFORCE_FW=true
# 进站时比对待执行的用例ID清单
ENFORCE_CASE_IDS=true
# 机台在线判定窗口（秒）
CLIENT_ONLINE_WINDOW_SECONDS=90
# 仪表盘统计窗口（天）
METRICS_WINDOW_DAYS=14
# 统计日界时区：今日良率 / 日趋势按该时区的自然日切分
# Python 3.9+ 且装有 tzdata 时按 IANA 名称解析；否则回退到下面的固定偏移
APP_TIMEZONE=Asia/Shanghai
APP_TZ_OFFSET_HOURS=8

# ---- 租约锁：崩溃续测与快速接管 ----
# 心跳断流超过该时长即判定机台失联，锁可被同工位其他机台接管（默认 2 分钟，
# 远小于工位 timeout_sec，避免"卡 30 分钟"）
LOCK_HEARTBEAT_GRACE_SEC=120
# 下发给上位机的建议心跳间隔（秒）
LOCK_HEARTBEAT_INTERVAL_SEC=30
# 孤儿锁回收任务周期（秒）
SWEEPER_INTERVAL_SEC=30
# 回收任务总开关（演示 C0990xx 场景数据时可置 false，避免僵尸锁被自动回收）
SWEEPER_ENABLED=true
# 连续失联达到该次数才计一次产品失败（崩溃/断网属机器问题，默认宽限 3 次）
LOST_LOCK_FAIL_THRESHOLD=3
# 出站时用 checkpoint 补齐未提交用例（续测核心）
MERGE_CHECKPOINT_ON_CHECKOUT=true
# 严格 fencing：请求未携带 lock_token 时拒绝（true = 老上位机必须先升级）。
# 注意：无论该开关取值如何，token 不匹配一律拒绝。
STRICT_LOCK_TOKEN=false

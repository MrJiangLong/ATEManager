# 工厂测试库（各型号一个分库，库名 = 型号；只读账号即可）
# 内部/驻场开发包：复制本文件为 .env 并填写密码；需内网 / VPN 可达
# 仓库内开发可省略（台架会回退读 backend/.env）；独立解包的分发包必须建 .env
FACTORY_DB_HOST=10.1.1.4
FACTORY_DB_PORT=5432
FACTORY_DB_USER=share_analyst
FACTORY_DB_PASSWORD=

# 可选：插件任意查询 api.sql 的资源上限（与线上同名同默认，改这里台架与线上一起生效）
# 运维调整线上 REPORT_SQL_* 时，请在本包 .env 填同样的值，避免台架与线上判定不一致
# REPORT_SQL_TIMEOUT_MS=30000
# REPORT_SQL_MAX_ROWS=50000
